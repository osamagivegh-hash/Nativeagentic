# ===========================================
# NEXUS AI PLATFORM - ENVIRONMENT CONFIG
# Copy this file to .env and fill in your values
# ===========================================

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexus_ai
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=nexus:

# Vector Database (pgvector extension)
VECTOR_DIMENSIONS=1536

# OpenAI Configuration (or compatible API)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h
ENCRYPTION_KEY=32-character-encryption-key-here

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# AI Orchestrator Settings
ORCHESTRATOR_MAX_RETRIES=3
ORCHESTRATOR_CONFIDENCE_THRESHOLD=0.7
ORCHESTRATOR_TIMEOUT_MS=30000

# Agent Configuration
AGENT_MAX_TOOL_CALLS=10
AGENT_PARALLEL_EXECUTION=true

# Proactive Intelligence
PROACTIVE_ENABLED=true
PROACTIVE_SCAN_INTERVAL_MS=300000
ANOMALY_THRESHOLD=2.5

# Audit & Compliance
AUDIT_ENABLED=true
AUDIT_RETENTION_DAYS=90






